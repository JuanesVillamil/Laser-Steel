{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/send-quote.js": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page/index.html", "destination": "/:page/", "permanent": true }
  ]
}
